<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{#if model.title}}{{model.title}}{{else}}{{title}}{{/if}} · {{config.site.name}}</title>
  {{!-- Every page sets its own `description` — a post's is its summary — and
        the tagline is only the fallback for one that does not. --}}
  <meta name="description" content="{{#if description}}{{description}}{{else}}{{config.site.tagline}}{{/if}}">
  <meta name="generator" content="kiss-ssg">
  {{#if config.siteUrl}}<link rel="canonical" href="{{canonical}}">{{/if}}
  {{!-- One link style, root-relative, on every page at every depth: a page by
        its id with `link`, a file the build wrote with "/" plus `asset`. So
        the site is previewed served from its build folder (`--dev`, or any
        static server rooted at public/), never opened off the file system. --}}
  <link rel="stylesheet" href="/{{asset 'css/site.css'}}">
  <link rel="icon" type="image/png" href="/{{asset 'img/icon.png'}}">
  {{!-- The card a link preview shows. Absolute, because a scraper never
        resolves a relative URL: `absUrl` joins `siteUrl` to the name `asset`
        emitted. --}}
  <meta property="og:image" content="{{absUrl (asset 'img/og-card.png')}}">
  {{#block "head"}}{{/block}}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="wrap site-header__inner">
      <a class="brand" href="{{link 'index'}}">
        <span class="brand__mark" aria-hidden="true">A&amp;O</span>
        <span class="brand__text">
          <strong>{{config.site.name}}</strong>
          <small>{{config.site.tagline}}</small>
        </span>
      </a>
      <nav class="nav" aria-label="Site">
        {{!-- The nav names pages by id; `link` turns each into the served
              path once, and `isActive` compares that same path with this
              page's and hands it back as {{href}}.
              One call per link: with the item's `folderMatch`, {{active}}
              marks the section this page is in, and {{current}} is true
              only on the link to this very page, which alone carries
              `aria-current="page"`. --}}
        {{#each config.nav}}
        {{#isActive .. href=(link id) folderMatch=folderMatch}}<a href="{{href}}" class="nav__link{{#if active}} is-active{{/if}}"{{#if current}} aria-current="page"{{/if}}>{{label}}</a>{{/isActive}}
        {{/each}}
      </nav>
    </div>
  </header>

  <main class="wrap" id="main">
    {{#block "main"}}{{/block}}

    {{#if showSource}}
    <section class="source-panel">
      <h2>How this example works</h2>
      {{#block "demo"}}{{/block}}
    </section>
    {{/if}}
  </main>

  <footer class="site-footer">
    <div class="wrap site-footer__inner">
      <p>&copy; {{config.site.name}} — a fictional roastery, built with&nbsp;<strong>kiss-ssg</strong>.</p>
      <p class="build-badge">
        {{#env is="dev"}}dev build · live reload on{{else}}production build · minified{{/env}}
      </p>
    </div>
  </footer>
</body>
</html>
