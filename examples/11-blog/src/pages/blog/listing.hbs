{{!-- One view, rendered at two depths: /blog/index.html and
      /blog/page/2/index.html. Nothing here depends on which: every link is
      asked for by identity, and `{{link}}` answers with a root-relative path. --}}
{{#extend "layout"}}

  {{#content "head"}}{{> "head-feed"}}{{/content}}

  {{#content "main"}}
  <section class="hero">
    <p class="eyebrow">The journal &middot; page {{model.number}} of {{model.of}}</p>
    <h1>{{title}}</h1>
    <p>{{description}}</p>
  </section>

  <div class="stack">
    {{#each model.posts}}{{> "post-card"}}{{/each}}
  </div>

  <nav class="callout" aria-label="Pagination">
    <p>
      {{#if model.prev}}<a href="{{link model.prev}}">&larr; Newer posts</a>{{else}}<span class="meta">&larr; Newer posts</span>{{/if}}
      &nbsp;&middot;&nbsp; page {{model.number}} of {{model.of}} &nbsp;&middot;&nbsp;
      {{#if model.next}}<a href="{{link model.next}}">Older posts &rarr;</a>{{else}}<span class="meta">Older posts &rarr;</span>{{/if}}
    </p>
  </nav>

  <div class="card">
    <h2>Browse by tag</h2>
    <p>{{#each model.tags}}<a class="tag" href="{{link 'blog/tags' slug=slug}}">{{tag}} ({{count}})</a> {{/each}}</p>
    <p class="meta"><a href="{{link 'blog/tags'}}">Every tag</a> &middot; <a href="/feed.xml">RSS feed</a></p>
  </div>
  {{/content}}

{{/extend}}
