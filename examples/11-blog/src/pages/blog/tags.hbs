{{#extend "layout"}}

  {{#content "head"}}{{> "head-feed"}}{{/content}}

  {{#content "main"}}
  <section class="hero">
    <p class="eyebrow">The journal</p>
    <h1>Tags</h1>
    <p>
      {{model.tally.tags}}, none of them written down anywhere: each one exists because some
      post mentions it, and <code>controllers/tag.js</code> folds the posts into one record per
      tag for the fan-out to build.
    </p>
  </section>

  <div class="grid">
    {{#each model.tags}}
    <article class="card">
      <h2><a href="{{link 'blog/tags' slug=slug}}">{{tag}}</a></h2>
      <p class="meta">{{postCount}}</p>
      <p>{{#each posts}}<a href="{{link id}}">{{title}}</a>{{#unless @last}} &middot; {{/unless}}{{/each}}</p>
    </article>
    {{else}}
    <p class="meta">No tags yet: a tag appears when a post is filed under it.</p>
    {{/each}}
  </div>

  <div class="callout">
    <p><a href="{{link 'blog'}}">The journal</a> &middot; <a href="/feed.xml">RSS feed</a></p>
  </div>
  {{/content}}

{{/extend}}
