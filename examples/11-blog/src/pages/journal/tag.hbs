{{!-- One page per tag, built by the same `.pages()` call shape the posts use —
      over a computed array rather than a models folder. --}}
{{#extend "layout"}}

  {{#content "head"}}{{> "head-feed"}}{{/content}}

  {{#content "main"}}
  <section class="hero">
    <p class="eyebrow">Tagged</p>
    <h1>{{model.tag}}</h1>
    <p>Filed under this tag: {{model.postCount}} from the journal, newest first.</p>
  </section>

  <div class="stack">
    {{#each model.posts}}{{> "post-card"}}{{/each}}
  </div>

  <div class="callout">
    <p><a href="{{link 'journal/tags'}}">Tags</a> &middot; <a href="{{link 'journal'}}">The journal</a></p>
  </div>
  {{/content}}

{{/extend}}
