{{!-- Every post sits at journal/<slug>/index.html, and nothing in this view knows
      that: the tag links and the link back to the journal are asked for by
      identity, and the engine answers with a path. --}}
{{#extend "layout"}}

  {{#content "head"}}{{> "head-feed"}}{{/content}}

  {{#content "main"}}
  <section class="hero">
    <p class="eyebrow"><time datetime="{{model.date}}">{{model.dateLabel}}</time></p>
    <h1>{{model.title}}</h1>
    <p>{{model.summary}}</p>
    <p>{{#each model.tags}}<a class="tag" href="{{link 'journal/tags' slug=this}}">{{this}}</a> {{/each}}</p>
  </section>

  <article class="card">
    {{markdown model.body}}
  </article>

  {{#if aliases}}
  <p class="meta">
    Formerly published at {{#each aliases}}<code>{{this}}</code>{{#unless @last}} and {{/unless}}{{/each}}.
    The build writes a <code>301</code> for each old address into <code>_redirects</code>, so
    links to them still arrive here, and <code>aliases</code> reaches this template like any
    other page option, which is how this sentence knows what to say.
    {{#if model.id}}This record also carries its own <code>id</code> —
    <code>{{model.id}}</code>, which does not contain the slug — so the page keeps one identity
    across a rename and <code>check</code> can report the <em>next</em> move as
    <code>moved without redirect:</code> rather than as a deletion.{{/if}}
  </p>
  {{/if}}

  {{#if broken}}
  {{#if model.staleLink}}
  <div class="callout">
    <h2>This run was started with <code>--broken</code></h2>
    <p class="tone-warn">
      So this post links to <a href="{{model.staleLink}}">a post that was never published</a> —
      the shape of breakage an edit leaves behind. No <code>\{{link}}</code> could land here: an
      id the registry does not hold fails the build instead of shipping. This one is a string in
      a record — like the handful of markdown links in the post bodies above — and a string is
      only ever checked by a reader. Nothing fails and nothing warns; the page
      builds and the run still exits 0. It is
      <code>npx kiss-ssg check router.js --summary -- --broken</code> that says so, in one
      line:
    </p>
    <pre><code>ok ./public (check) — 15 pages, 0 failed, 3 assets, 622ms
  broken link: ./public/journal/the-cascara-experiment/index.html -&gt; {{model.staleLink}}
  ~ ./public/journal/the-cascara-experiment/index.html
  = 14 unchanged</code></pre>
  </div>
  {{/if}}
  {{/if}}

  <div class="callout">
    <p><a href="{{link 'journal'}}">&larr; Back to the journal</a> &middot; <a href="/feed.xml">RSS feed</a></p>
  </div>
  {{/content}}

{{/extend}}
