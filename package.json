{
  "name": "kiss-ssg",
  "version": "2.4.0",
  "description": "Simple Static Website Generator",
  "main": "lib/kiss.js",
  "types": "./types/kiss.d.ts",
  "exports": {
    ".": {
      "types": "./types/kiss.d.ts",
      "import": "./lib/kiss.js",
      "require": "./lib/kiss.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "bin": {
    "kiss-ssg": "bin/kiss-ssg.js"
  },
  "files": [
    "bin",
    "lib",
    "types",
    "llms.txt",
    "AIKB",
    "examples",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "prepublishOnly": "npm run gates",
    "postpublish": "node scripts/tag-release.mjs",
    "test": "vitest run",
    "types": "node scripts/emit-types.mjs",
    "version": "node scripts/sync-plugin-versions.mjs && git add .claude-plugin/marketplace.json plugins/*/.claude-plugin/plugin.json",
    "gates": "node scripts/gates.mjs",
    "bench": "node scripts/bench.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs": "node docs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eg1": "cd examples/1-scan && node router",
    "eg2": "cd examples/2-page && node router",
    "eg3": "cd examples/3-pages && node router",
    "eg4": "cd examples/4-layouts-and-partials && node router",
    "eg5": "cd examples/5-helpers && node router",
    "eg6": "cd examples/6-sitemap && node router",
    "eg7": "cd examples/7-versioned-outputs && node router",
    "eg8": "cd examples/8-data-fed-site && node router",
    "eg9": "cd examples/9-migrated-from-v1 && node router",
    "eg10": "cd examples/10-asset-pipeline && node router",
    "eg11": "cd examples/11-blog && node router"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cprobert/kiss-ssg.git"
  },
  "author": "Courtenay Probert",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/cprobert/kiss-ssg/issues"
  },
  "homepage": "https://github.com/cprobert/kiss-ssg",
  "dependencies": {
    "chokidar": "^5.0.0",
    "colors": "^1.4.0",
    "connect": "^3.7.0",
    "fs-extra": "^11.4.0",
    "glob": "^13.0.6",
    "handlebars": "^4.7.7",
    "handlebars-layouts": "^3.1.4",
    "html-minifier-terser": "^7.2.0",
    "livereload": "^0.10.3",
    "remarkable": "^2.0.1",
    "sass": "^1.104.0",
    "serve-static": "^2.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "generator",
    "markdown",
    "ssg",
    "static",
    "website",
    "jekyll",
    "gatsby",
    "hugo",
    "gridsome"
  ]
}
