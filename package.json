{
  "name": "kiss-ssg",
  "version": "2.13.2",
  "description": "Simple Static Website Generator",
  "main": "lib/kiss.js",
  "types": "./types/kiss.d.ts",
  "exports": {
    ".": {
      "types": "./types/kiss.d.ts",
      "import": "./lib/kiss.js",
      "require": "./lib/kiss.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "bin": {
    "kiss-ssg": "bin/kiss-ssg.js"
  },
  "files": [
    "bin",
    "lib",
    "types",
    "llms.txt",
    "GUIDE.md",
    "AIKB",
    "examples",
    "starter",
    "!examples/*/public",
    "!examples/*/.converted",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "prepublishOnly": "npm run gates",
    "postpublish": "node scripts/tag-release.mjs",
    "test": "vitest run",
    "types": "node scripts/emit-types.mjs",
    "version": "node scripts/sync-plugin-versions.mjs && git add .claude-plugin/marketplace.json plugins/*/.claude-plugin/plugin.json",
    "gates": "node scripts/gates.mjs",
    "bench": "node scripts/bench.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs": "node docs",
    "dev": "node docs --dev",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eg1": "cd examples/1-scan && node router",
    "eg2": "cd examples/2-page && node router",
    "eg3": "cd examples/3-pages && node router",
    "eg4": "cd examples/4-layouts-and-partials && node router",
    "eg5": "cd examples/5-helpers && node router",
    "eg6": "cd examples/6-sitemap && node router",
    "eg7": "cd examples/7-versioned-outputs && node router",
    "eg8": "cd examples/8-data-fed-site && node router",
    "eg9": "cd examples/9-migrated-from-v1 && node router",
    "eg10": "cd examples/10-asset-pipeline && node router",
    "eg11": "cd examples/11-blog && node router",
    "eg12": "cd examples/12-from-a-single-file && node router",
    "eg13": "cd examples/13-course-packages && node router",
    "eg14": "cd examples/14-consent && node router"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cprobert/kiss-ssg.git"
  },
  "author": "Courtenay Probert",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/cprobert/kiss-ssg/issues"
  },
  "homepage": "https://cprobert.github.io/kiss-ssg/",
  "dependencies": {
    "@mixmark-io/domino": "^2.2.0",
    "chokidar": "^6.0.0",
    "clean-css": "^5.3.3",
    "colors": "^1.4.0",
    "connect": "^3.7.0",
    "fs-extra": "^11.4.1",
    "glob": "^14.0.4",
    "handlebars": "^4.7.10",
    "handlebars-layouts": "^3.1.4",
    "html-minifier-terser": "^7.2.0",
    "htmlparser2": "^12.0.0",
    "livereload": "^0.10.3",
    "postcss": "^8.5.28",
    "purgecss": "^8.0.0",
    "remarkable": "^2.0.1",
    "sass": "^1.108.0",
    "serve-static": "^2.2.1",
    "sharp": "^0.35.5",
    "terser": "^5.51.2",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "peerDependencies": {
    "lighthouse": "^13"
  },
  "peerDependenciesMeta": {
    "lighthouse": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "generator",
    "markdown",
    "ssg",
    "static",
    "website",
    "jekyll",
    "gatsby",
    "hugo",
    "gridsome"
  ]
}
