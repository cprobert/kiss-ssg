{
  "name": "kiss-ssg",
  "version": "2.0.0-alpha.0",
  "description": "Simple Static Website Generator",
  "main": "lib/kiss.js",
  "type": "module",
  "files": [
    "lib",
    "llms.txt",
    "AIKB"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "prepublishOnly": "npm run gates",
    "test": "vitest run",
    "gates": "node scripts/gates.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs": "node docs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "eg1": "cd examples && node 1-scan",
    "eg2": "cd examples && node 2-page",
    "eg3": "cd examples && node 3-pages",
    "eg4": "cd examples && node 4-layouts-and-partials",
    "eg5": "cd examples && node 5-helpers",
    "eg6": "cd examples && node 6-sitemap"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cprobert/kiss-ssg.git"
  },
  "author": "Courtenay Probert",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/cprobert/kiss-ssg/issues"
  },
  "homepage": "https://courtenay.probert.me.uk/kiss-ssg",
  "dependencies": {
    "chokidar": "^5.0.0",
    "colors": "^1.4.0",
    "connect": "^3.7.0",
    "fs-extra": "^11.4.0",
    "glob": "^13.0.6",
    "handlebars": "^4.7.7",
    "handlebars-layouts": "^3.1.4",
    "html-minifier-terser": "^7.2.0",
    "livereload": "^0.10.3",
    "remarkable": "^2.0.1",
    "sass": "^1.104.0",
    "serve-static": "^2.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "generator",
    "markdown",
    "ssg",
    "static",
    "website",
    "jekyll",
    "gatsby",
    "hugo",
    "gridsome"
  ]
}
