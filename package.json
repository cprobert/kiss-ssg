{
  "name": "kiss-ssg",
  "version": "2.0.0-alpha.0",
  "description": "Simple Static Website Generator",
  "main": "kiss-ssg.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs": "node docs",
    "lint": "eslint .",
    "eg1": "cd examples && node 1-scan",
    "eg2": "cd examples && node 2-page",
    "eg3": "cd examples && node 3-pages",
    "eg4": "cd examples && node 4-layouts-and-partials",
    "eg5": "cd examples && node 5-helpers",
    "eg6": "cd examples && node 6-sitemap"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cprobert/kiss-ssg.git"
  },
  "author": "Courtenay Probert",
  "license": "Apache 2.0",
  "bugs": {
    "url": "https://github.com/cprobert/kiss-ssg/issues"
  },
  "homepage": "https://courtenay.probert.me.uk/kiss-ssg",
  "dependencies": {
    "chokidar": "^3.5.1",
    "colors": "^1.4.0",
    "connect": "^3.7.0",
    "fs-extra": "^9.1.0",
    "glob": "^7.1.6",
    "handlebars": "^4.7.7",
    "handlebars-layouts": "^3.1.4",
    "html-minifier-terser": "^7.2.0",
    "livereload": "^0.9.1",
    "remarkable": "^2.0.1",
    "sass": "^1.32.8",
    "serve-static": "^1.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "generator",
    "markdown",
    "ssg",
    "static",
    "website",
    "jekyll",
    "gatsby",
    "hugo",
    "gridsome"
  ]
}
