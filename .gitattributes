# `types/` is emitted by tsc (`npm run types`), which always writes LF, and
# test/unit/types.test.js byte-compares the checked-in files against a fresh
# emit. On a Windows clone with core.autocrlf=true git would smudge them to
# CRLF on checkout and that test could never pass, so pin the working tree to
# match what tsc emits.
types/*.d.ts text eol=lf
