{{#extend "layout"}}
{{#content "main"}}
<section class="hero">
  <div class="wrap hero__inner">
    <div class="hero__copy">
      {{!-- Written for what someone types into a search box or an AI, not for
            what kiss is internally. The first search is "professional website
            with AI": it names the outcome rather than one agent, now that the
            skills serve Claude Code and Codex alike. The second is the upgrade
            path for a site already made in Claude or ChatGPT. Both are in the
            heading, the broader one first. --}}
      <h1 class="hero__title">Build a professional website with AI <span class="hero__title-more">— or upgrade the one you made in Claude or ChatGPT</span></h1>
      <p class="lede">
        kiss-ssg turns a description, or a site you already have, into a website you can host anywhere,
        edit yourself and hand to a developer. It checks every build before it goes live. Free and open source.
      </p>
      <div class="hero__actions">
        <div class="command">
          <code>npx kiss-ssg@latest init</code>
          <button type="button" class="command__copy" data-copy="npx kiss-ssg@latest init">Copy</button>
        </div>
        <a class="text-link" href="{{link "guide/index" absolute=true}}">Read the guide</a>
      </div>
    </div>

    <aside class="toolkit" aria-labelledby="toolkit">
      <h2 class="toolkit__title" id="toolkit">{{model.toolkit.heading}}</h2>
      <p class="toolkit__intro">{{model.toolkit.intro}}</p>
      <ul class="toolkit__list">
        {{#each model.toolkit.tools}}
        <li class="tool">
          <span class="tool__icon">{{> (lookup . "icon")}}</span>
          <div class="tool__body">
            <p class="tool__name">
              {{#if url}}<a href="{{url}}" target="_blank" rel="noopener noreferrer">{{name}}<span class="visually-hidden"> (opens in a new tab)</span></a>{{else}}{{name}}{{/if}}
              <span class="tool__need tool__need--{{level}}">{{need}}</span>
            </p>
            <p class="tool__what">{{what}}</p>
            {{#if options}}
            <ul class="tool__options">
              {{#each options}}
              <li><a href="{{url}}" target="_blank" rel="noopener noreferrer"><span class="tool__option-icon">{{> (lookup . "icon")}}</span>{{name}}<span class="visually-hidden"> (opens in a new tab)</span></a></li>
              {{/each}}
            </ul>
            {{/if}}
          </div>
        </li>
        {{/each}}
      </ul>
    </aside>
  </div>
</section>

<section class="band" aria-labelledby="how">
  <div class="wrap">
    <h2 id="how">{{model.setup.heading}}</h2>
    <p class="band__lede">{{model.setup.intro}}</p>
    <ol class="steps steps--stacked">
      {{#each model.setup.steps}}
      <li class="steps__item">
        <h3>{{title}}</h3>
        <p>{{text}}</p>
        {{#if code}}<pre><code class="language-bash">{{code}}</code></pre>{{/if}}
        {{#if boxes}}
        {{!-- One box per agent, each complete on its own so it copies in one go. --}}
        <div class="agent-boxes">
          {{#each boxes}}
          <div class="agent-box">
            <div class="agent-box__head">
              <h4 class="agent-box__label">{{label}}</h4>
              <button type="button" class="agent-box__copy" data-copy="{{code}}" aria-label="Copy the {{label}} commands">Copy</button>
            </div>
            <pre><code class="language-bash">{{code}}</code></pre>
            <p class="agent-box__note">{{note}}</p>
          </div>
          {{/each}}
        </div>
        {{/if}}
        {{#if prompts}}
        <ul class="prompts">
          {{#each prompts}}
          <li class="prompts__item">
            <p class="prompts__label">{{label}}</p>
            <p class="prompts__note">{{note}}</p>
            <p class="prompts__text">{{text}}</p>
          </li>
          {{/each}}
        </ul>
        {{/if}}
      </li>
      {{/each}}
    </ol>
    <p class="band__note">
      kiss is the upgrade path for a site you made in Claude or ChatGPT: converting keeps it looking exactly
      the same and gives it a layout, partials and content a web developer could take over:
      <a href="{{link "guide/converting" absolute=true}}">how converting works</a>. Using an agent other
      than these two, such as Cursor or Copilot? Point it at <code>node_modules/kiss-ssg/llms.txt</code>
      and have it run the check.
    </p>
  </div>
</section>

<section class="band band--split" aria-labelledby="why">
  <div class="wrap band__grid">
    <h2 id="why">Why kiss-ssg suits AI coding agents</h2>
    <ul class="reasons">
      {{#each model.reasons}}
      <li>
        <h3>{{title}}</h3>
        <p>{{text}}</p>
      </li>
      {{/each}}
    </ul>
  </div>
</section>

<section class="band" aria-labelledby="built-with">
  <div class="wrap">
    <h2 id="built-with">Websites built with kiss-ssg</h2>
    {{!-- Full width, under the heading. The image sits outside the link, so the
          site's name is the only link and the alt text says what the screenshot
          shows. width/height are the files' own (768×480), so the card keeps its
          shape before the image loads; CSS scales it to the card. --}}
    <ul class="sites">
      {{#each model.sites}}
      <li class="site-card">
        <img class="site-card__shot" src="{{absUrl (asset image)}}" width="768" height="480" loading="lazy" alt="{{alt}}">
        <div class="site-card__body">
          <h3 class="site-card__name"><a href="{{url}}" target="_blank" rel="noopener noreferrer">{{name}}<span class="visually-hidden"> (opens in a new tab)</span></a></h3>
          <p class="site-card__what">{{description}}</p>
        </div>
      </li>
      {{/each}}
    </ul>
    <p class="band__note">
      Writing it yourself instead? The <a href="{{link "guide/index" absolute=true}}">guide</a> covers every
      method, option and helper.
    </p>
  </div>
</section>
{{/content}}
{{/extend}}
