<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{#if fullTitle}}{{fullTitle}}{{else}}{{title}} – kiss-ssg{{/if}}</title>
  <meta name="description" content="{{description}}">
  <meta name="author" content="Courtenay Probert">
  <meta name="generator" content="kiss-ssg {{version}}">
  <link rel="canonical" href="{{canonical}}">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="kiss-ssg">
  <meta property="og:title" content="{{#if fullTitle}}{{fullTitle}}{{else}}{{title}}{{/if}}">
  <meta property="og:description" content="{{description}}">
  <meta property="og:url" content="{{canonical}}">
  <meta property="og:image" content="{{absUrl (asset "img/og.png")}}">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="{{absUrl (asset "favicon.svg")}}" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Mono:wght@400;600&family=Atkinson+Hyperlegible+Next:ital,wght@0,400;0,700;0,800;1,400&display=swap">
  <link rel="stylesheet" href="{{absUrl (asset "css/site.css")}}">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {{> "layout/header"}}

  <main id="main">
    {{#block "main"}}{{/block}}
  </main>

  {{> "layout/footer"}}

  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/handlebars.min.js"></script>
  <script src="{{absUrl (asset "js/site.js")}}"></script>
</body>
</html>
