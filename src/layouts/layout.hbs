<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {{!-- A theme the visitor chose with the header toggle, applied before the first paint so the page never flashes the other one. No choice saved: the device setting decides, through the stylesheet. --}}
  <script>try { var t = localStorage.getItem('kiss-docs-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t } catch (e) {}</script>
  <title>{{#if fullTitle}}{{fullTitle}}{{else}}{{title}} – kiss-ssg{{/if}}</title>
  <meta name="description" content="{{description}}">
  <meta name="author" content="Courtenay Probert">
  <meta name="generator" content="kiss-ssg {{version}}">
  <link rel="canonical" href="{{canonical}}">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="kiss-ssg">
  <meta property="og:title" content="{{#if fullTitle}}{{fullTitle}}{{else}}{{title}}{{/if}}">
  <meta property="og:description" content="{{description}}">
  <meta property="og:url" content="{{canonical}}">
  <meta property="og:image" content="{{absUrl (asset "img/og.png")}}">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="icon" href="{{absUrl (asset "img/icon-64.png")}}" type="image/png">
  <link rel="apple-touch-icon" href="{{absUrl (asset "img/icon-180.png")}}">
  {{!-- The body font is preloaded: site.css names it, so without this the
        browser finds it only after the stylesheet has arrived. --}}
  <link rel="preload" href="{{absUrl (asset "fonts/atkinson-hyperlegible-next-normal-latin.woff2")}}" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{absUrl (asset "css/site.css")}}">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {{> "layout/header"}}

  <main id="main">
    {{#block "main"}}{{/block}}
  </main>

  {{> "layout/footer"}}

  {{!-- Says out loud what a Copy button did; a button's own changed text is not announced. --}}
  <p class="visually-hidden" aria-live="polite" data-copy-status></p>

  {{!-- highlight.js 11.9.0 (BSD-3-Clause), served from this site. --}}
  <script src="{{absUrl (asset "js/vendor/highlight-11.9.0.min.js")}}"></script>
  <script src="{{absUrl (asset "js/vendor/highlight-handlebars-11.9.0.min.js")}}"></script>
  <script src="{{absUrl (asset "js/site.js")}}"></script>
</body>
</html>
